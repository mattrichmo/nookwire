# Local persistent database; create the directory with private permissions first.
NOOKWIRE_DB=/var/lib/nookwire/nookwire.sqlite
NOOKWIRE_BIND=127.0.0.1
NOOKWIRE_PORT=8787

# For a public HTTPS deployment, replace these with the approved host and origin.
NOOKWIRE_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
NOOKWIRE_ALLOWED_ORIGINS=localhost,127.0.0.1,[::1]

# Optional: set only when the app is behind a controlled proxy. Use exact CIDRs.
# NOOKWIRE_TRUSTED_PROXIES=
