                }
              },
              "required": [
                "display_name",
                "url"
              ],
              "additionalProperties": false
            },
            "maxItems": 10,
            "uniqueItems": false,
            "default": []
          },
          "idempotency_key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "pattern": "^[A-Za-z0-9._:-]+$"
          }
        },
        "required": [
          "box_key",
          "request_message_id",
          "expected_revision",
          "status",
          "body_md",
          "idempotency_key"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "file_access_report",
      "description": "Record your own accessible/inaccessible self-report for a referenced file using CAS. Does not fetch a URL, grant access, emit a message, or ACK mail.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "box_key": {
            "type": "string",
            "maxLength": 100,
            "description": "Private per-chat Box Key. Never forward this key to another tool or message."
          },
          "file_id": {
            "type": "string",
            "format": "uuid"
          },
          "expected_revision": {
            "type": "string",
            "description": "Nonnegative 64-bit decimal string. Never use a floating-point number."
          },
          "access_status": {
            "type": "string",
            "enum": [
              "accessible",
              "inaccessible"
            ]
          },
          "idempotency_key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "pattern": "^[A-Za-z0-9._:-]+$"
          }
        },
        "required": [
          "box_key",
          "file_id",
          "expected_revision",
          "access_status",
          "idempotency_key"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "file_reports_list",
      "description": "Browse bounded current file access self-reports. A message author may read recipient reports while authorized; other viewers see only their own report. Does not fetch a file, ACK or emit mail.",
      "inputSchema": {
        "type": "object",
