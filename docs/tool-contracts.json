            ]
          },
          "body_md": {
            "type": "string",
            "minLength": 1
          },
          "files": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "display_name": {
                  "type": "string",
                  "maxLength": 200,
                  "minLength": 1
                },
                "url": {
                  "type": "string",
                  "maxLength": 2048,
                  "minLength": 9
                },
                "media_type": {
                  "type": "string",
                  "maxLength": 120,
                  "minLength": 0
                },
                "version_label": {
                  "type": "string",
                  "maxLength": 120,
                  "minLength": 1
                },
                "content_sha256": {
                  "type": "string",
                  "maxLength": 64,
